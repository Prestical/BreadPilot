{
  "name": "@breadpilot/circuit-core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Shared circuit model, connection DSL, and safety validator (used by api and web).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "pretypecheck": "npm run gen:parts",
    "typecheck": "tsc -p tsconfig.json",
    "gen:pinout": "node --import tsx scripts/gen-pinout.ts",
    "gen:parts": "node --import tsx scripts/gen-parts.ts",
    "gen:api": "node --import tsx scripts/gen-api.ts",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "tsx": "^4.20.0"
  }
}
