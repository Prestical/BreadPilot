{
  "id": "dht11",
  "name": "DHT11 temperature and humidity sensor",
  "category": "sensor",
  "legs": [
    {
      "id": "vcc",
      "label": "VCC (leg 1)",
      "kind": "power_in",
      "voltageRange": { "value": [3.3, 5.5], "src": { "doc": "DHT11-Aosong-product-manual.pdf", "page": 4, "note": "Pin Description: 1. VDD supply 3.3~5.5V DC" } }
    },
    { "id": "data", "label": "DATA (leg 2)", "kind": "digital_out", "level": "vcc" },
    { "id": "nc", "label": "NC (leg 3, not connected)" },
    { "id": "gnd", "label": "GND (leg 4)", "kind": "ground" }
  ],
  "elements": [
    {
      "kind": "load",
      "a": "vcc",
      "b": "gnd",
      "currentMa": { "value": 0.3, "src": { "doc": "DHT11-Aosong-product-manual.pdf", "page": 4, "note": "Supply current: Measure 0.3mA, Standby 60uA" } }
    }
  ],
  "specs": {
    "legOrder": {
      "value": ["vcc", "data", "nc", "gnd"],
      "src": { "doc": "DHT11-Aosong-product-manual.pdf", "page": 4, "note": "Pin Description 1-4; the user's pin picture shows the same order, left to right with the grid facing you" }
    },
    "pullUpOhms": { "value": 5100, "src": { "doc": "DHT11-Aosong-product-manual.pdf", "page": 4, "note": "typical circuit: 5.1K pull-up for cables shorter than 20 m" } },
    "minReadIntervalS": { "value": 2, "src": { "doc": "DHT11-Aosong-product-manual.pdf", "page": 4, "note": "Sampling period: greater than 2 seconds; each read returns the previous measurement" } },
    "startupWaitS": { "value": 1, "src": { "doc": "DHT11-Aosong-product-manual.pdf", "page": 6, "note": "after power-up wait 1 s before sending any command" } },
    "temperatureAccuracyC": { "value": 2, "src": { "doc": "DHT11-Aosong-product-manual.pdf", "page": 3 } },
    "humidityAccuracyRH": { "value": 5, "src": { "doc": "DHT11-Aosong-product-manual.pdf", "page": 3 } },
    "temperatureRangeC": { "value": [0, 50], "src": { "product": "robotistan.com product page 'DHT11 Temperature and Humidity Sensor' (read 11/11/2026)" } },
    "humidityRangeRH": { "value": [20, 90], "src": { "product": "robotistan.com product page 'DHT11 Temperature and Humidity Sensor' (read 11/11/2026)" } },
    "note": "Powered from 3V3 here, so its data line (pulled up to VCC) stays at the Pico's 3.3 V."
  }
}
