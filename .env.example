# Development settings (npm run dev:api, npm run dev:desktop). Copy to .env (cp .env.example .env)
# and make it readable only by you, because it can hold your OpenAI key: chmod 600 .env
# No database settings: the database (PGlite) runs inside the app, saved encrypted in .local/data
# (development) or the app-data folder (desktop app).

# --- Local LLM (Ollama running natively on macOS, OpenAI-compatible API) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_NUM_CTX=16384
EMBED_MODEL=nomic-embed-text

# --- Optional: OpenAI model (users can pick it on the start screen) ---
# Leave the key empty to offer only the local model. Projects that use it send the idea, plan and
# code to OpenAI and are billed to this key. Embeddings and documentation search stay local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high (gpt-6-luna is a reasoning model; low is fast and cheap)
OPENAI_REASONING_EFFORT=low

# --- API ---
API_PORT=3000
LOG_LEVEL=info
