# Copy to .env (cp .env.example .env) and set a password. Then make it readable only by you,
# because it holds the database password and your OpenAI key: chmod 600 .env

# --- Database ---
POSTGRES_USER=hwedu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hwedu
# Used when running the API on the host (npm run dev:api). DB is exposed on 127.0.0.1:5433.
DATABASE_URL=postgres://hwedu:change-me@localhost:5433/hwedu

# --- Local LLM (Ollama running natively on macOS, OpenAI-compatible API) ---
# Host dev value. Docker overrides this with http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_NUM_CTX=16384
EMBED_MODEL=nomic-embed-text

# --- Optional: OpenAI model (users can pick it on the start screen) ---
# Leave the key empty to offer only the local model. Projects that use it send the idea, plan and
# code to OpenAI and are billed to this key. Embeddings and documentation search stay local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high (gpt-6-luna is a reasoning model; low is fast and cheap)
OPENAI_REASONING_EFFORT=low

# --- API ---
API_PORT=3000
LOG_LEVEL=info
