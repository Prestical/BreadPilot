{
  "name": "@breadpilot/api",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "ingest": "tsx --env-file-if-exists=../../.env src/ingest-cli.ts",
    "eval:rag": "tsx --env-file-if-exists=../../.env src/eval-rag-cli.ts",
    "eval:agent": "tsx --env-file-if-exists=../../.env src/eval-agent-cli.ts",
    "eval:models": "tsx --env-file-if-exists=../../.env src/eval-agent-cli.ts --file data/eval/models.jsonl",
    "eval:parts": "tsx --env-file-if-exists=../../.env src/eval-agent-cli.ts --file data/eval/parts-m15.jsonl",
    "eval:changes": "tsx --env-file-if-exists=../../.env src/eval-changes-cli.ts",
    "template": "node --import tsx src/template-cli.ts",
    "check:models": "node --import tsx src/check-models-cli.mts",
    "typecheck": "tsc -p tsconfig.json",
    "predev": "npm run gen:parts -w @breadpilot/circuit-core",
    "prebuild": "npm run gen:parts -w @breadpilot/circuit-core",
    "pretypecheck": "npm run gen:parts -w @breadpilot/circuit-core"
  },
  "dependencies": {
    "@breadpilot/circuit-core": "*",
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@fastify/static": "10.1.6",
    "fastify": "^5.4.0",
    "pdfjs-dist": "^4.10.38",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
